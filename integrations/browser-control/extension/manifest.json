{
  "manifest_version": 3,
  "name": "WodeAppX Browser Control",
  "version": "1.4.1",
  "description": "在 Chrome 侧栏中与 WodeAppX 对话，让 AI 读取、点击、输入并自动完成当前网页任务。",
  "homepage_url": "https://wodeapp.cn",
  "permissions": [
    "activeTab",
    "alarms",
    "debugger",
    "nativeMessaging",
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "WodeAppX Browser Control",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
